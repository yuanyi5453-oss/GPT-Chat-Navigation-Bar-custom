{
  "manifest_version": 3,
  "name": "GPT页面增强工具",
  "version": "2026.10.5",
  "version_name": "2026-V11 多站点适配版",
  "minimum_chrome_version": "114",
  "description": "为 ChatGPT、Gemini、Grok、DeepSeek 网页增加问题目录、专注阅读、选择性导出、引用管理和排版工具。",
  "permissions": [
    "storage",
    "clipboardWrite"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "host_permissions": [
    "https://chat.openai.com/*",
    "https://chatgpt.com/*",
    "https://gemini.google.com/*",
    "https://grok.com/*",
    "https://chat.deepseek.com/*",
    "https://raw.githubusercontent.com/AnDaoCc/GPT-Chat-Navigation-Bar/main/compat/chatgpt-dom-rules.json"
  ],
  "icons": {
    "16": "assets/icon16.png",
    "32": "assets/icon32.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  },
  "background": {
    "service_worker": "assets/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "GPT页面增强工具",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "assets/icon16.png",
      "32": "assets/icon32.png",
      "48": "assets/icon48.png",
      "128": "assets/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://chat.openai.com/*",
        "https://chatgpt.com/*",
        "https://gemini.google.com/*",
        "https://grok.com/*",
        "https://chat.deepseek.com/*"
      ],
      "js": [
        "assets/contentScript.js"
      ],
      "css": [
        "assets/contentScript.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
